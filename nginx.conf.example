# ============================================================================
# FabluX.U.Design — example nginx server block
# Copy into /etc/nginx/sites-available/, adjust server_name + certificate
# paths, then:  nginx -t && systemctl reload nginx
# ============================================================================

# Force HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name fablux.pages.dev www.fablux.pages.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name fablux.pages.dev www.fablux.pages.dev;

    ssl_certificate     /etc/letsencrypt/live/fablux.pages.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fablux.pages.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    root  /var/www/fablux;
    index index.html;

    # ---- security headers -------------------------------------------------
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://msisbmcowtggbvasubla.supabase.co; upgrade-insecure-requests" always;

    # ---- compression ------------------------------------------------------
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/xml image/svg+xml;
    # If the brotli module is installed, also enable:
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css application/javascript application/json image/svg+xml;

    # ---- caching ----------------------------------------------------------
    location ~* ^/(css|js)/ {
        expires 5m;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        access_log off;
        try_files $uri =404;
    }

    location ~* ^/images/ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
        access_log off;
        try_files $uri =404;
    }

    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "public, max-age=0, must-revalidate";
        try_files $uri =404;
    }

    location = /health.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"status":"ok"}';
    }

    # Custom 404
    error_page 404 /404.html;
    location = /404.html { internal; }

    location / {
        try_files $uri $uri/ =404;
    }
}
