PORT=5000
HOST=127.0.0.1
NODE_ENV=development
DB_FILE=./data/fablux.sqlite
SESSION_TTL_DAYS=30
ADMIN_EMAIL=admin@fablux.local
ADMIN_PASSWORD=change-this-before-production
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
ADMIN_ACCESS_PATH=/admin-access
APP_BASE_URL=http://127.0.0.1:5000
RESET_TOKEN_MINUTES=30
# Email: use Resend when ready. Keep credentials out of source control.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=

# Payments (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_RESERVATION_MINUTES=20
